DATABASE_URL=jdbc:postgresql://postgres:5432/reconcile
DATABASE_USER=reconcile
DATABASE_PASSWORD=defina-uma-senha-forte-diferente-do-usuario
JWT_SECRET=substitua-por-64-caracteres-aleatorios-para-assinar-jwt-hs512!!!
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081
# IPs TCP do reverse proxy (nginx/ALB). Vazio = nunca confiar em X-Real-IP / X-Forwarded-For.
TRUSTED_PROXIES=
# false em produção: remove as contas piloto após o migrate.
SEED_DEMO=true
