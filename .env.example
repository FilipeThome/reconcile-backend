DATABASE_URL=jdbc:postgresql://postgres:5432/reconcile
DATABASE_USER=reconcile
DATABASE_PASSWORD=defina-uma-senha-forte-diferente-do-usuario
JWT_SECRET=substitua-por-64-caracteres-aleatorios-para-assinar-jwt-hs512!!!
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081
# IPs TCP do reverse proxy (nginx/ALB). Vazio = nunca confiar em X-Real-IP / X-Forwarded-For.
TRUSTED_PROXIES=
# false em produção: remove as contas piloto após o migrate.
SEED_DEMO=true
# false: não mantém pedidos/pagamentos de demonstração (use para testar OAuth real).
SEED_LEDGER=false

# URLs oficiais — Brasil. Preencha o APP ID / partner id do console do marketplace.
OAUTH_FRONTEND_REDIRECT=http://localhost:5173/integracoes
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# URI pública HTTPS do callback (ngrok/Dev Tunnel). O backend local continua em HTTP:
#   devtunnel host -p 8080 --allow-anonymous --protocol http
MERCADO_LIVRE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/ml/callback
MERCADO_LIVRE_AUTHORIZE_URL=https://auth.mercadolivre.com.br/authorization
MERCADO_LIVRE_TOKEN_URL=https://api.mercadolibre.com/oauth/token
MERCADO_LIVRE_API_URL=https://api.mercadolibre.com
MERCADO_LIVRE_PKCE=true
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/shopee/callback
SHOPEE_AUTHORIZE_URL=https://open.shopee.com.br/auth
SHOPEE_TOKEN_URL=https://openplatform.shopee.com.br/api/v2/auth/token/get
SHOPEE_API_URL=https://openplatform.shopee.com.br
