DATABASE_URL=jdbc:postgresql://postgres:5432/reconcile
DATABASE_USER=reconcile
DATABASE_PASSWORD=defina-uma-senha-forte-diferente-do-usuario
JWT_SECRET=substitua-por-64-caracteres-aleatorios-para-assinar-jwt-hs512!!!
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081
# IPs TCP do reverse proxy (nginx/ALB). Vazio = nunca confiar em X-Real-IP / X-Forwarded-For.
TRUSTED_PROXIES=
# false em produção: remove as contas piloto após o migrate.
SEED_DEMO=true
# true: pedidos/casos de maio/2026. false: ledger vazio para OAuth real (exige recriar o volume).
SEED_LEDGER=true

# URLs oficiais — Brasil. Preencha o APP ID / partner id do console do marketplace.
OAUTH_FRONTEND_REDIRECT=http://localhost:5173/integracoes
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# URI pública HTTPS do callback (ngrok/Dev Tunnel). O backend local continua em HTTP:
#   devtunnel host -p 8080 --allow-anonymous --protocol http
MERCADO_LIVRE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/ml/callback
MERCADO_LIVRE_AUTHORIZE_URL=https://auth.mercadolivre.com.br/authorization
MERCADO_LIVRE_TOKEN_URL=https://api.mercadolibre.com/oauth/token
MERCADO_LIVRE_API_URL=https://api.mercadolibre.com
# Aviso de venda: o Mercado Livre não assina as notificações, então a URL leva um segredo seu (32+ caracteres aleatórios).
# Cadastre no DevCenter, tópico orders_v2: https://SEU-DOMINIO/api/v1/integrations/webhooks/ml/<MERCADO_LIVRE_WEBHOOK_SECRET>
# Vazio = avisos de venda do Mercado Livre recusados.
MERCADO_LIVRE_WEBHOOK_SECRET=
MERCADO_LIVRE_PKCE=true
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/shopee/callback
SHOPEE_AUTHORIZE_URL=https://open.shopee.com.br/auth
SHOPEE_TOKEN_URL=https://openplatform.shopee.com.br/api/v2/auth/token/get
SHOPEE_API_URL=https://openplatform.shopee.com.br
# URL pública HTTPS exata cadastrada no console Shopee (Push Mechanism), usada para validar a assinatura:
#   https://SEU-DOMINIO/api/v1/integrations/webhooks/shopee
SHOPEE_PUSH_URL=
# OLX: client id/secret são emitidos pelo suporte ao integrador (suporteintegrador@olxbr.com) e exigem plano profissional.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/olx/callback
OLX_AUTHORIZE_URL=https://auth.olx.com.br/oauth
OLX_TOKEN_URL=https://auth.olx.com.br/oauth/token
OLX_API_URL=https://apps.olx.com.br
OLX_SCOPE=basic_user_info autoupload autoservice
# URL pública HTTPS do aviso de anúncio vendido: https://SEU-DOMINIO/api/v1/integrations/webhooks/olx
OLX_WEBHOOK_URL=
# true: remove o anúncio OLX (id do anúncio = SKU) quando o estoque do SKU zera em outro marketplace.
OLX_DELETE_SOLD_ADS=false
# Login with Amazon (Seller Central Brasil) + AWS SigV4 da Selling Partner API.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/amazon/callback
AMAZON_AUTHORIZE_URL=https://sellercentral.amazon.com.br/apps/authorize/consent
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_API_URL=https://sellingpartnerapi-na.amazon.com
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_AWS_SESSION_TOKEN=
AMAZON_AWS_REGION=us-east-1
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
